<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExemploMVVM.Views.pgPessoa"
             Title="pgPessoa">
    <StackLayout Padding="20">
        <Label Text="MVVM"
               FontSize="50"
               HorizontalTextAlignment="Center"/>

        <Label Text="Insira o seu nome:"
               FontSize="30"/>
        <!--o Binding é o responsavel pelo vinculo
        entre a tela e o código
        OBS: é preciso seguir a nomenclatura da propriedade
        a risca para o funcionamento corrto-->
        <Entry Text="{Binding Nome}"/>

        <Button Text="Executar"
                Command="{Binding CommandExecutar}"
                FontSize="25"/>

        <Label Text="{Binding Retorno}"
               FontSize="30"
               TextColor="Blue"/>

        <Button Text="Visualizar"
                Command="{Binding CommandVisualizar}"/>
    </StackLayout>
</ContentPage>